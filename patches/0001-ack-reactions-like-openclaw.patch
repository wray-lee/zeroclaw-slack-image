@@ -4170,6 +4170,39 @@ impl ::zeroclaw_api::attribution::Attributable for TelegramChannel {
 
 #[async_trait]
 impl Channel for TelegramChannel {
+    /// Withdraw the bot's ack reaction once the reply is done. A bot has a single
+    /// reaction slot per message, so setting an empty list clears it.
+    async fn remove_reaction(
+        &self,
+        channel_id: &str,
+        message_id: &str,
+        _emoji: &str,
+    ) -> anyhow::Result<()> {
+        let (chat_id, _) = Self::parse_reply_target(channel_id);
+        let Some(msg_id) = message_id
+            .rsplit('_')
+            .next()
+            .and_then(|s| s.parse::<i64>().ok())
+        else {
+            return Ok(());
+        };
+        let body = serde_json::json!({
+            "chat_id": chat_id,
+            "message_id": msg_id,
+            "reaction": []
+        });
+        let resp = self
+            .http_client()
+            .post(self.api_url("setMessageReaction"))
+            .json(&body)
+            .send()
+            .await?;
+        if !resp.status().is_success() {
+            anyhow::bail!("Telegram setMessageReaction (clear) failed: {}", resp.status());
+        }
+        Ok(())
+    }
+
     fn name(&self) -> &str {
         "telegram"
     }
